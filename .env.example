# AI Model Configuration
# Replace the values below with your own endpoint and key.

AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://ai.rebelstack.fun
AI_MODEL=jandel/free

# ── Flask / Auth Configuration ─────────────────────────────────────────────
# Secret key for Flask session cookies.
# Generate a strong one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-string

# Default admin credentials (created only on first run, when the DB is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
