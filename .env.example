# AI Model Configuration
# Replace the values below with your own endpoint and key.

AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://ai.rebelstack.fun
AI_MODEL=jandel/free

# ── Flask / Auth Configuration ─────────────────────────────────────────────
# Secret key for Flask session cookies.
# Generate a strong one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-string

# Default admin credentials (created only on first run, when the DB is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# ── Performance / small-server tuning ────────────────────────────────────────
# Parallel processes used by scikit-learn during training. The code auto-clamps
# this to the number of CPU cores; set 1 on a single-vCPU / low-RAM host.
# CRABLOX_TRAIN_JOBS=1
# Molecules processed per RDKit descriptor batch (lower = less RAM).
# CRABLOX_DESC_BATCH_SIZE=1000
# Above this many training rows, hyper-parameter search uses a stratified
# subsample (final model still trains on all rows).
# CRABLOX_TUNE_MAX_ROWS=20000
